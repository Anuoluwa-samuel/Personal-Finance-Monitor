# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Public origin of the app (used for auth callbacks and trusted origins)
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM=Ispentit <no-reply@example.com>
# Required in production for verification and reset emails
RESEND_API_KEY=

# Integration tests only; the database name MUST end in _test
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:54340/ispentit_test
# Required for /api/cron/recurring (Vercel Cron sends it as a Bearer token). At least 16 random characters.
CRON_SECRET=

# Shown in the Terms of Service and Privacy Policy. Set all three before a public launch.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
# Place whose law governs the Terms, e.g. the country or state where the operator is based
LEGAL_JURISDICTION=
